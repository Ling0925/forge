{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Forge superproject: pinned Core, CLI, Web UI and Android modules",
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build-core.mjs",
    "build:cli": "node scripts/build-core.mjs",
    "cli": "node dist/cli.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "serve:core": "node repos/forge-core/dist/web/serve.js",
    "test": "node --test scripts/superproject.test.mjs"
  }
}
