<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ForgeMobile" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/system_bar_dark_icons</item>
    </style>

    <!-- Style names deliberately avoid dots: a dotted name implies an implicit parent style. -->
    <style name="ForgeTextTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="ForgeTextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="ForgePrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/accent_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="ForgeSecondaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
