<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:saveEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/http_auth_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/http_auth_description"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/http_auth_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/http_auth_username"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionNext|flagNoPersonalizedLearning"
            android:singleLine="true"
            android:saveEnabled="false"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/http_auth_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/http_auth_password"
            android:inputType="textPassword"
            android:imeOptions="actionGo|flagNoPersonalizedLearning"
            android:singleLine="true"
            android:saveEnabled="false"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
